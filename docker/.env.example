# 服务器配置
PORT=3000
NODE_ENV=production

# JWT密钥 (请修改为随机字符串)
JWT_SECRET=your-super-secret-jwt-key-change-this

# 数据加密密钥 (请修改为32位随机字符串)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# 数据库路径
DB_PATH=./data/newmail.db

# 日志路径
LOG_PATH=./data/logs

# 客户端URL (用于CORS)
CLIENT_URL=http://localhost:3000

# 日志级别
LOG_LEVEL=info
