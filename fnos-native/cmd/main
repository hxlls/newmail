#!/bin/bash

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# TRIM_APPDEST = /vol1/@appcenter/newmail
# app.tgz 解压后文件直接在这个目录下
APP_DIR="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    log_msg "NewMail is already running"
    return 0
  fi
  
  log_msg "Starting NewMail..."
  log_msg "APP_DIR=$APP_DIR"
  
  # 检查应用目录
  if [ ! -d "$APP_DIR" ]; then
    log_msg "ERROR: App directory not found: $APP_DIR"
    echo "ERROR: App directory not found" > "$TRIM_TEMP_LOGFILE"
    return 1
  fi
  
  # 检查入口文件
  if [ ! -f "$APP_DIR/server/src/index.js" ]; then
    log_msg "ERROR: Entry file not found: $APP_DIR/server/src/index.js"
    log_msg "Directory contents:"
    ls -la "$APP_DIR/" >> "$LOG_FILE" 2>&1
    echo "ERROR: Entry file not found" > "$TRIM_TEMP_LOGFILE"
    return 1
  fi
  
  # 加载环境变量
  if [ -f "$DATA_DIR/.env" ]; then
    export $(grep -v '^#' "$DATA_DIR/.env" | xargs)
    log_msg "Loaded env"
  fi
  
  # 设置默认值
  export PORT=${PORT:-3000}
  export NODE_ENV=production
  export DB_PATH=${DB_PATH:-$DATA_DIR/data/newmail.db}
  export LOG_PATH=${LOG_PATH:-$DATA_DIR/logs}
  export CLIENT_URL=http://localhost:${PORT}
  
  # 创建必要目录
  mkdir -p "$DATA_DIR/data"
  mkdir -p "$DATA_DIR/logs"
  
  # 启动应用
  cd "$APP_DIR" || exit 1
  log_msg "Starting node..."
  
  node server/src/index.js >> "$LOG_FILE" 2>&1 &
  local node_pid=$!
  echo "$node_pid" > "$PID_FILE"
  
  log_msg "Node PID: $node_pid"
  
  # 等待启动
  sleep 3
  
  if check_process "$node_pid"; then
    log_msg "NewMail started successfully"
    return 0
  else
    log_msg "ERROR: Node process exited"
    rm -f "$PID_FILE"
    return 1
  fi
}

stop_app() {
  log_msg "Stopping NewMail..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi
  
  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi
  
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  sleep 2
  kill -KILL "$pid" 2>> "$LOG_FILE" || true
  rm -f "$PID_FILE"
  log_msg "NewMail stopped"
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  log)
    LINES="${2:-100}"
    tail -n "$LINES" "$LOG_FILE" 2>/dev/null || echo "No log"
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
