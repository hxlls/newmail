#!/bin/bash

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

case "$1" in
  start)
    cd "${TRIM_APPDEST}/target"
    
    # 加载环境变量
    if [ -f "${TRIM_PKGVAR}/.env" ]; then
      export $(grep -v '^#' "${TRIM_PKGVAR}/.env" | xargs)
    fi
    
    # 设置默认值
    export PORT=${PORT:-3000}
    export NODE_ENV=production
    export DB_PATH=${DB_PATH:-${TRIM_PKGVAR}/data/newmail.db}
    export LOG_PATH=${LOG_PATH:-${TRIM_PKGVAR}/logs}
    export CLIENT_URL=http://localhost:${PORT}
    
    # 创建必要目录
    mkdir -p "${TRIM_PKGVAR}/data"
    mkdir -p "${TRIM_PKGVAR}/logs"
    
    # 启动应用
    echo "Starting NewMail on port ${PORT}..."
    node server/src/index.js >> "${TRIM_PKGVAR}/newmail.log" 2>&1 &
    echo $! > "${TRIM_PKGVAR}/newmail.pid"
    
    # 等待启动
    sleep 3
    if kill -0 $(cat "${TRIM_PKGVAR}/newmail.pid") 2>/dev/null; then
      echo "NewMail started successfully"
      exit 0
    else
      echo "NewMail failed to start, check ${TRIM_PKGVAR}/newmail.log"
      exit 1
    fi
    ;;
    
  stop)
    if [ -f "${TRIM_PKGVAR}/newmail.pid" ]; then
      PID=$(cat "${TRIM_PKGVAR}/newmail.pid")
      if kill -0 "$PID" 2>/dev/null; then
        echo "Stopping NewMail..."
        kill "$PID"
        sleep 2
        kill -9 "$PID" 2>/dev/null || true
      fi
      rm -f "${TRIM_PKGVAR}/newmail.pid"
    fi
    exit 0
    ;;
    
  status)
    if [ -f "${TRIM_PKGVAR}/newmail.pid" ]; then
      PID=$(cat "${TRIM_PKGVAR}/newmail.pid")
      if kill -0 "$PID" 2>/dev/null; then
        echo "NewMail is running"
        exit 0
      fi
    fi
    echo "NewMail is not running"
    exit 3
    ;;
    
  log)
    LINES="${2:-100}"
    if [ -f "${TRIM_PKGVAR}/newmail.log" ]; then
      tail -n "$LINES" "${TRIM_PKGVAR}/newmail.log"
    else
      echo "No log file found"
    fi
    exit 0
    ;;
    
  *)
    exit 1
    ;;
esac
