#!/bin/bash

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

echo "Installing NewMail..."

# 创建数据目录
mkdir -p "${TRIM_PKGVAR}/data"
mkdir -p "${TRIM_PKGVAR}/logs"

# 复制应用文件到target目录
TARGET_DIR="${TRIM_APPDEST}/target"
mkdir -p "$TARGET_DIR"

# 复制server和client
cp -r "${TRIM_APPDEST}/app/server" "$TARGET_DIR/"
cp -r "${TRIM_APPDEST}/app/client" "$TARGET_DIR/"
cp "${TRIM_APPDEST}/app/package.json" "$TARGET_DIR/" 2>/dev/null || true

# 安装后端依赖
cd "$TARGET_DIR/server"
echo "Installing server dependencies..."
npm ci --only=production

# 安装前端依赖并构建
cd "$TARGET_DIR/client"
echo "Installing client dependencies..."
npm ci
echo "Building frontend..."
npm run build

# 生成环境变量
JWT_SECRET=$(openssl rand -hex 32)
ENCRYPTION_KEY=$(openssl rand -hex 16)

cat > "${TRIM_PKGVAR}/.env" << EOF
PORT=3000
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
DB_PATH=${TRIM_PKGVAR}/data/newmail.db
LOG_PATH=${TRIM_PKGVAR}/logs
NODE_ENV=production
EOF

echo "NewMail installed successfully"
