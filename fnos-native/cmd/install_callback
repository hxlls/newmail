#!/bin/bash

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${TRIM_PKGVAR}/install.log"
}

log_msg "Initializing NewMail..."

# 创建数据目录
mkdir -p "${TRIM_PKGVAR}/data"
mkdir -p "${TRIM_PKGVAR}/logs"

# 重新编译原生模块
APP_DIR="${TRIM_APPDEST}"
log_msg "APP_DIR=$APP_DIR"

if [ -d "$APP_DIR/server" ]; then
  log_msg "Rebuilding native modules in $APP_DIR/server..."
  cd "$APP_DIR/server"
  
  # 删除旧的编译文件
  rm -rf node_modules/better-sqlite3/build
  rm -rf node_modules/better-sqlite3/prebuilds
  
  # 重新编译
  npm rebuild better-sqlite3 --build-from-source 2>&1 >> "${TRIM_PKGVAR}/install.log"
  
  if [ $? -eq 0 ]; then
    log_msg "Native modules rebuilt successfully"
  else
    log_msg "ERROR: Failed to rebuild native modules"
  fi
else
  log_msg "ERROR: Server directory not found at $APP_DIR/server"
fi

# 生成环境变量
JWT_SECRET=$(openssl rand -hex 32)
ENCRYPTION_KEY=$(openssl rand -hex 16)

cat > "${TRIM_PKGVAR}/.env" << EOF
PORT=3000
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
DB_PATH=${TRIM_PKGVAR}/data/newmail.db
LOG_PATH=${TRIM_PKGVAR}/logs
NODE_ENV=production
EOF

log_msg "NewMail installed successfully"
