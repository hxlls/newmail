#!/bin/bash

export PATH=/var/apps/nodejs_v22/target/bin:$PATH

case "$1" in
  start)
    # 应用目录
    APP_DIR="${TRIM_APPDEST}/target"
    
    # 如果target不存在，尝试直接路径
    if [ ! -d "$APP_DIR" ]; then
      APP_DIR="/vol1/@appcenter/newmail"
    fi
    
    # 检查应用目录
    if [ ! -d "$APP_DIR/app" ]; then
      echo "ERROR: Application directory not found: $APP_DIR" >&2
      exit 1
    fi
    
    # 数据目录
    DATA_DIR="${TRIM_PKGVAR}"
    if [ -z "$DATA_DIR" ] || [ ! -d "$DATA_DIR" ]; then
      DATA_DIR="/vol1/@appdata/newmail"
    fi
    
    # 加载环境变量
    if [ -f "$DATA_DIR/.env" ]; then
      export $(grep -v '^#' "$DATA_DIR/.env" | xargs)
    fi
    
    # 设置默认值
    export PORT=${PORT:-3000}
    export NODE_ENV=production
    export DB_PATH=${DB_PATH:-$DATA_DIR/data/newmail.db}
    export LOG_PATH=${LOG_PATH:-$DATA_DIR/logs}
    export CLIENT_URL=http://localhost:${PORT}
    
    # 创建必要目录
    mkdir -p "$DATA_DIR/data"
    mkdir -p "$DATA_DIR/logs"
    
    # 启动应用
    echo "Starting NewMail on port ${PORT}..."
    cd "$APP_DIR/app"
    node server/src/index.js >> "$DATA_DIR/newmail.log" 2>&1 &
    echo $! > "$DATA_DIR/newmail.pid"
    
    # 等待启动
    sleep 3
    if [ -f "$DATA_DIR/newmail.pid" ] && kill -0 $(cat "$DATA_DIR/newmail.pid") 2>/dev/null; then
      echo "NewMail started successfully"
      exit 0
    else
      echo "NewMail failed to start, check $DATA_DIR/newmail.log"
      exit 1
    fi
    ;;
    
  stop)
    DATA_DIR="${TRIM_PKGVAR}"
    if [ -z "$DATA_DIR" ] || [ ! -d "$DATA_DIR" ]; then
      DATA_DIR="/vol1/@appdata/newmail"
    fi
    
    if [ -f "$DATA_DIR/newmail.pid" ]; then
      PID=$(cat "$DATA_DIR/newmail.pid")
      if kill -0 "$PID" 2>/dev/null; then
        echo "Stopping NewMail..."
        kill "$PID"
        sleep 2
        kill -9 "$PID" 2>/dev/null || true
      fi
      rm -f "$DATA_DIR/newmail.pid"
    fi
    exit 0
    ;;
    
  status)
    DATA_DIR="${TRIM_PKGVAR}"
    if [ -z "$DATA_DIR" ] || [ ! -d "$DATA_DIR" ]; then
      DATA_DIR="/vol1/@appdata/newmail"
    fi
    
    if [ -f "$DATA_DIR/newmail.pid" ]; then
      PID=$(cat "$DATA_DIR/newmail.pid")
      if kill -0 "$PID" 2>/dev/null; then
        echo "NewMail is running"
        exit 0
      fi
    fi
    echo "NewMail is not running"
    exit 3
    ;;
    
  log)
    DATA_DIR="${TRIM_PKGVAR}"
    if [ -z "$DATA_DIR" ] || [ ! -d "$DATA_DIR" ]; then
      DATA_DIR="/vol1/@appdata/newmail"
    fi
    
    LINES="${2:-100}"
    if [ -f "$DATA_DIR/newmail.log" ]; then
      tail -n "$LINES" "$DATA_DIR/newmail.log"
    else
      echo "No log file found"
    fi
    exit 0
    ;;
    
  *)
    exit 1
    ;;
esac
